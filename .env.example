# ─────────────────────────────────────────────────────────────────────────────
# Codon — environment template.  COPY THIS to `.env.local` and fill real values.
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored and must NEVER be committed.
# The REAL values live in two safe places only:
#   1. Vercel (Project → Settings → Environment Variables, encrypted), and
#   2. your local `.env.local` / password manager.
#
# Fastest way to get the real values into a fresh checkout (needs Vercel CLI + login):
#   vercel link                 # link this folder to the "codon" project
#   vercel env pull .env.local  # writes the real values locally (still git-ignored)
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase: Auth + Postgres -------------------------------------------------
# Project ref "ijfgonujgdytykfyxjlf" is NOT secret (it's in the public API URL).
SUPABASE_URL=https://ijfgonujgdytykfyxjlf.supabase.co
# Secret/service key — bypasses RLS, SERVER-ONLY. Supabase → Settings → API Keys.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_JWKS_URL=https://ijfgonujgdytykfyxjlf.supabase.co/auth/v1/.well-known/jwks.json
# Browser-safe anon/publishable key (optional; only if wiring client-side calls).
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# --- E2B: trusted server-side code execution -----------------------------------
# Get / rotate at https://e2b.dev/dashboard → API Keys.
E2B_API_KEY=e2b_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Cron: scheduled re-verification -------------------------------------------
# Any random string. Vercel sends it as `Authorization: Bearer <CRON_SECRET>`
# to /api/cron/*. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=generate_a_random_hex_string
